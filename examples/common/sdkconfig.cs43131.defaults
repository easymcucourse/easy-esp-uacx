# CS43131 (3302:98c2) S3 FS listening test, including the known white-noise rates.
# Verified filtering is off so 48/88.2/96 kHz stay openable; the FS table registers 44.1 kHz only.
CONFIG_EUACX_USE_VERIFIED_CAPS=n
CONFIG_EUACX_DUMP_DESCRIPTORS=n
CONFIG_EXAMPLE_PLAYBACK_BARS=4
CONFIG_EXAMPLE_SOAK_SECONDS=0
CONFIG_EXAMPLE_LIFECYCLE_TEST=n
CONFIG_EXAMPLE_CS43131_FS_TEST=y
CONFIG_EXAMPLE_CS43131_TEST_VOLUME_DB=-20
