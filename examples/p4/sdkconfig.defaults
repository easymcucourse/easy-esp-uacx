CONFIG_IDF_TARGET="esp32p4"
CONFIG_EUACX_NUM_TRANSFERS=4


CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
# CS43198 (2fc6:f0fc) declares a 776-byte ISO OUT MPS; the default BALANCED
# split caps periodic OUT at 512 bytes on the HS port.
CONFIG_USB_HOST_HW_BUFFER_BIAS_PERIODIC_OUT=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
