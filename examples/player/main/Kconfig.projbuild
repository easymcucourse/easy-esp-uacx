menu "Music Player"

    config MUSIC_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Station-mode network name. Leave empty to disable Wi-Fi, the web
            interface, and TCP OTA. The generated sdkconfig is ignored by Git.

    config MUSIC_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Station-mode network password. It is stored only in the local
            sdkconfig and compiled firmware; do not add sdkconfig to Git.

endmenu
